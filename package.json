{
  "name": "comb",
  "version": "0.1.0",
  "description": "Write circuits. Ship apps. A SystemVerilog-inspired reactive web framework.",
  "type": "module",
  "main": "src/runtime/index.ts",
  "module": "src/runtime/index.ts",
  "bin": {
    "comb": "./src/cli/cli.ts"
  },
  "exports": {
    ".": "./src/runtime/index.ts",
    "./compiler": "./src/core/compiler.ts",
    "./router": "./src/runtime/router.ts"
  },
  "files": [
    "src/core/",
    "src/runtime/",
    "src/cli/"
  ],
  "scripts": {
    "compile": "tsx src/cli/cli.ts compile",
    "compile:all": "tsx src/cli/cli.ts compile --all",
    "dev": "vite",
    "build": "vite build",
    "playground": "vite --open /playground.html",
    "typecheck": "tsc --noEmit",
    "comb:test": "tsx src/cli/test.ts",
    "test:headless": "tsx --test src/core/headless-test.ts",
    "test:autotest": "tsx --test src/runtime/autotest-test.ts",
    "test:temporal": "tsx --test src/runtime/temporal-test.ts src/runtime/autotest-test.ts src/core/headless-test.ts src/cli/test-runner-test.ts"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "kiwi.js": "^1.1.3"
  }
}
